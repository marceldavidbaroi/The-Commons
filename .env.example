# ==============================================================================
# THE COMMONS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development or customize .env.local.docker
# and .env.local.prod using the predefined pnpm scripts:
#   - pnpm run env:local (copies .env.local.docker -> .env.local)
#   - pnpm run env:prod  (copies .env.local.prod   -> .env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Public / Browser & Server)
# ------------------------------------------------------------------------------
# Local Docker default: http://127.0.0.1:54321
# Production format:   https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local Docker anon key or Production Project API Anon/Publishable Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 2. Supabase Server & Admin Key (Optional / Server-Only)
# ------------------------------------------------------------------------------
# Service role key with full bypass permissions for backend admin jobs
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Database Connection & Migration Deployment (.env.local.prod only)
# ------------------------------------------------------------------------------
# Remote Supabase Project Reference (e.g., rbnbgyytxgkkcrmkgnro)
SUPABASE_PROJECT_REF=your-project-ref

# Option A: Direct PostgreSQL Connection URI (Used by scripts/deploy-migrations.mjs)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<your-project-ref>.supabase.co:5432/postgres"

# Option B: Database Password for Supabase CLI automated link & push
# SUPABASE_DB_PASSWORD="your-database-password"

# Option C: Supabase Personal Access Token (CI/CD environments)
# SUPABASE_ACCESS_TOKEN="sbp_xxxxxxxxxxxxxxxxxxxx"
